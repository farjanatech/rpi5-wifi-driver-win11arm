; Raspberry Pi 5 CYW43455 direct-SDIO fake-Ethernet driver
; Windows 11 ARM64 - NDIS 6.30

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGuid   = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 08/24/2026,0.2.1.0
CatalogFile = rpi5cyw.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12
Driver_CopyFiles = 12

[Manufacturer]
%ProviderName% = Models,NTARM64

[Models.NTARM64]
%DeviceDesc% = Device_Install.ndi, ACPI\RPI0011

[Device_Install.ndi.NT]
Characteristics    = 0x4
BusType            = 0
*IfType            = 6
*MediaType         = 0
*PhysicalMediaType = 14
AddReg             = Device_AddReg
CopyFiles          = Driver_CopyFiles

[Device_Install.ndi.NT.Services]
AddService = rpi5cyw, 0x00000002, Service_Install

[Device_AddReg]
HKR,Ndi,Service,0,"rpi5cyw"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"ethernet"

[Driver_CopyFiles]
rpi5cyw.sys

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\rpi5cyw.sys
LoadOrderGroup = NDIS

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
rpi5cyw.sys = 1

[Strings]
ProviderName = "farjanatech"
ServiceDesc  = "Raspberry Pi 5 CYW43455 Direct SDIO Ethernet Driver"
DeviceDesc   = "Raspberry Pi 5 CYW43455 Direct SDIO Network Adapter"
DiskName     = "Raspberry Pi 5 CYW43455 Direct SDIO Driver"
